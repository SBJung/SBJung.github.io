# frozen_string_literal: true

source "https://rubygems.org"

# Local preview toolchain for this GitHub Pages site.
# The `researcher` theme files live in this repo (_layouts, _sass, css),
# so no remote_theme / theme gem is needed.
gem "jekyll", "~> 4.0"

gem "kramdown-parser-gfm"

# Ruby 3+ no longer bundles webrick, which `jekyll serve` needs.
gem "webrick"
